{
  "name": "vitre",
  "version": "0.1.0",
  "description": "Liquid glass for the web: UI components that refract, bend and light up what is behind them. Real lens refraction with color fringes, specular rims and springy touch.",
  "keywords": [
    "liquid-glass",
    "glass",
    "glassmorphism",
    "refraction",
    "lens",
    "backdrop-filter",
    "svg-filter",
    "ui",
    "components",
    "buttons",
    "switch",
    "slider",
    "tab-bar",
    "design-system",
    "css"
  ],
  "license": "MIT",
  "author": "Raphael Pellerin",
  "homepage": "https://github.com/RaphaelPelerin/vitre#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RaphaelPelerin/vitre.git"
  },
  "bugs": {
    "url": "https://github.com/RaphaelPelerin/vitre/issues"
  },
  "type": "module",
  "sideEffects": [
    "*.css",
    "./dist/vitre.iife.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/vitre.css",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/vitre.iife.js",
  "jsdelivr": "./dist/vitre.iife.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsdown && esbuild src/vitre.css --minify --outfile=dist/vitre.css --log-level=warning",
    "build:demo": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "esbuild": "^0.28.2",
    "publint": "^0.3.25",
    "puppeteer-core": "^25.16.0",
    "tsdown": "^0.23.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
